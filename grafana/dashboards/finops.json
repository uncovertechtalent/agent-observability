{
  "uid": "finops",
  "title": "FinOps: the bill",
  "description": "One bill in the shape of a FinOps tool: AWS from the cost exporter, Claude Code API calls from Loki at list price, fixed costs by hand; cost centers by rule, this month against last, movers, anomalies, unit costs, record types. Internal; not shared.",
  "tags": [
    "agent-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15m",
  "time": {
    "from": "now/M",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "The bill, this month",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "One bill",
      "description": "AWS month to date, plus the Claude Code API calls in the dashboard's range at their list price, plus the fixed costs entered in fixed-costs.json. Added server side from the three sources.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(aws_cost_mtd_usd)",
          "refId": "A",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "RA",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cost_usd | unwrap cost_usd [$__range]))",
          "refId": "B",
          "queryType": "instant",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "RB",
          "type": "reduce",
          "expression": "B",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(fixed_cost_month_usd) or vector(0)",
          "refId": "C",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "RC",
          "type": "reduce",
          "expression": "C",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "SUM",
          "type": "math",
          "expression": "$RA + $RB + $RC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "AWS, month to date",
      "description": "Unblended cost from the 1st (UTC) to now, today's partial cost included. Cost Explorer lags by up to a day.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(aws_cost_mtd_usd)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Claude Code API calls, list price",
      "description": "What the API calls in the range would cost at list price, from Claude Code's own api_request events. The subscription covers them; the amount is what the subscription is worth this month.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cost_usd | unwrap cost_usd [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Fixed costs entered",
      "description": "Monthly subscriptions and seats from fixed-costs.json. Items without a price are counted on the data row below and left out here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(fixed_cost_month_usd) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "AWS vs last month, same days",
      "description": "Complete days 1 to N of this month against days 1 to N of last month (N on the data row). Positive is up. A domain renewal or the monthly tax in one window and not the other shows here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(aws_cost_to_date_usd{period=\"this_month\"}) - max(aws_cost_to_date_usd{period=\"prior_month\"})) / max(aws_cost_to_date_usd{period=\"prior_month\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "id": 6
    },
    {
      "type": "gauge",
      "title": "Forecast / budget",
      "description": "Cost Explorer's month-end forecast against the MONTHLY budget in AWS Budgets. Red above 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(aws_cost_month_forecast_usd) / max(aws_budget_limit_usd{period=\"MONTHLY\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "id": 7
    },
    {
      "type": "row",
      "title": "Cost centers (virtual tags)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "id": 8
    },
    {
      "type": "barchart",
      "title": "Daily spend by cost center",
      "description": "Every (service, usage type) pair mapped to a cost center by the rules in allocation.json; 'unallocated' is what no rule explains. This month and the three months before.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aws_cost_day_by_cost_center_usd",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "cost_center",
            "rowField": "day",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day\\cost_center"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "day\\cost_center",
        "stacking": "normal",
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 10
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Cost centers, this month against last",
      "description": "Complete days 1 to N of each month. The footer sums the columns.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cost_center) (aws_cost_to_date_by_cost_center_usd{period=\"this_month\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cost_center) (aws_cost_to_date_by_cost_center_usd{period=\"prior_month\"})",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "this month to date",
              "Value #B": "last month, same days"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "change",
            "binary": {
              "left": "this month to date",
              "operator": "-",
              "right": "last month, same days"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "this month to date",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "change"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "id": 10
    },
    {
      "type": "bargauge",
      "title": "Top movers, by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Change against the same days of last month, largest increase first. A service that appears on one side only counts in full.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(10, sort_desc(((sum by (service) (aws_cost_to_date_by_service_usd{period=\"this_month\"})) or (sum by (service) (aws_cost_to_date_by_service_usd{period=\"prior_month\"})) * 0) - ((sum by (service) (aws_cost_to_date_by_service_usd{period=\"prior_month\"})) or (sum by (service) (aws_cost_to_date_by_service_usd{period=\"this_month\"})) * 0))))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "id": 11
    },
    {
      "type": "row",
      "title": "Where the money goes",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "id": 12
    },
    {
      "type": "bargauge",
      "title": "Top usage types this month",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Month to date per usage type, the finest grain Cost Explorer gives without a usage report. A usage type names the region, the instance size or the storage class.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(12, aws_cost_mtd_by_usage_type_usd))",
          "refId": "A",
          "legendFormat": "{{service}}: {{usage_type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 10
      },
      "id": 13
    },
    {
      "type": "barchart",
      "title": "Months by record type",
      "description": "Usage, tax, credits and refunds per calendar month. Credits and refunds post as negative amounts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aws_cost_month_record_usd",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "record_type",
            "rowField": "month",
