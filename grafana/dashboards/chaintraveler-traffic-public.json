    {
      "type": "timeseries",
      "title": "App opens per hour",
      "description": "Online app opens by browsers, per hour.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
