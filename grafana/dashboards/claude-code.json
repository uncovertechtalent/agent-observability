    {
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1m",
      "title": "Spend alert: trailing hour above USD 40",
      "description": "The ClaudeCodeSpendSpike Prometheus alert. Pending once the cost of the trailing hour, all models together, passes USD 40; firing after 10 minutes above it. Before the rule went live on 2026-10-09 at 11:00 UTC the row replays it on the recorded hourly cost, which starts at 07:29 UTC that day.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max_over_time((((max(2 * ALERTS{alertname=\"ClaudeCodeSpendSpike\", alertstate=\"firing\"} or ALERTS{alertname=\"ClaudeCodeSpendSpike\", alertstate=\"pending\"}) or vector(0)) and on() (vector(time()) >= 1791543621)) or (((sum(model:claude_code_cost_usd:sum1h) > bool 40) + (min_over_time(sum(model:claude_code_cost_usd:sum1h)[10m:1m]) > bool 40)) and on() (vector(time()) < 1791543621)))[$__interval:1m])",
          "refId": "A",
          "legendFormat": "ClaudeCodeSpendSpike"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "below USD 40",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "pending",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "firing",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 4
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Cost per hour by model",
      "description": "Cost of the API calls in the trailing hour. The red line is the USD 40 threshold of the spend alert; the stacked total is what the alert reads.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep model, cost_usd | unwrap cost_usd [1h]))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed+area"
            },
            "axisSoftMax": 50.0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "timeseries",
