{
  "uid": "claude-code",
  "title": "Claude Code agents",
  "description": "Spend, tokens, tools and traces from Claude Code's OpenTelemetry export. Spend and tokens are summed from one event per API call.",
  "tags": [
    "agent-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Spend and volume",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Cost (range)",
      "description": "Sum of cost_usd over every API call in the range, as Claude Code prices it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cost_usd | unwrap cost_usd [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Tokens (range)",
      "description": "Input, output, cache read and cache write tokens of every API call in the range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep input_tokens | unwrap input_tokens [$__range])) + sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep output_tokens | unwrap output_tokens [$__range])) + sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cache_read_tokens | unwrap cache_read_tokens [$__range])) + sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cache_creation_tokens | unwrap cache_creation_tokens [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Cache read share (range)",
      "description": "Input tokens served from the prompt cache. Drops after compaction or when the system prompt changes.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cache_read_tokens | unwrap cache_read_tokens [$__range])) / (sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep input_tokens | unwrap input_tokens [$__range])) + sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cache_read_tokens | unwrap cache_read_tokens [$__range])) + sum(sum_over_time({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep cache_creation_tokens | unwrap cache_creation_tokens [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 4
    },
