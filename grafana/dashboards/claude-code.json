        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep input_tokens | unwrap input_tokens [5m]))",
          "refId": "A",
          "legendFormat": "input"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | keep output_tokens | unwrap output_tokens [5m]))",
