{
  "uid": "site-traffic-public",
  "title": "Site traffic (public)",
  "description": "Visits to the static sites on CloudFront, from the access logs. Counts only: the logs hold no IP address, and no User-Agent string or full referrer URL reaches Loki.",
  "tags": [
    "agent-observability",
    "sites"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Totals over the selected range",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Page views",
      "description": "HTML pages served with status 200 to browsers. Bots, assets, redirects and errors excluded.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"site-traffic\", agent=\"human\"} | json | kind=\"page\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Requests, all",
      "description": "Every request CloudFront logged: pages, assets, redirects, errors, bots.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"site-traffic\"} [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Bot requests",
      "description": "Requests whose User-Agent names a crawler, a script or nothing at all.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"site-traffic\", agent=\"bot\"} [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Countries",
      "description": "Countries with at least one page view. CloudFront derives the country; no IP address is stored.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (country) (count_over_time({job=\"site-traffic\", agent=\"human\"} | json | kind=\"page\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Over time",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Page views per hour",
      "description": "Page views by browsers, per hour and site.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (site) (count_over_time({job=\"site-traffic\", agent=\"human\"} | json | kind=\"page\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Responses by status code",
      "description": "All requests, bots included, per hour and status code.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({job=\"site-traffic\"} | json [$__interval]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "row",
      "title": "What and from where",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Top pages",
      "description": "Most viewed pages over the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(25, sum by (site, path) (count_over_time({job=\"site-traffic\", agent=\"human\"} | json | kind=\"page\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "site": 0,
              "path": 1,
              "Value #A": 2
            },
            "renameByName": {
              "site": "Site",
              "path": "Page",
              "Value #A": "Views"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Views",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Countries",
      "description": "ISO 3166 country code CloudFront derives from the viewer address.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (country) (count_over_time({job=\"site-traffic\", agent=\"human\"} | json | kind=\"page\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "country": 0,
              "Value #A": 1
            },
            "renameByName": {
              "country": "Country",
              "Value #A": "Views"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Views",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "id": 11
    },
    {
      "type": "table",
      "title": "Crawlers and scripts",
      "description": "Bot requests by the agent the User-Agent names. other = a generic bot pattern.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (bot) (count_over_time({job=\"site-traffic\", agent=\"bot\"} | json [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "bot": 0,
              "Value #A": 1
            },
            "renameByName": {
              "bot": "Agent",
              "Value #A": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 10
      },
      "id": 12
    },
    {
      "type": "stat",
      "title": "Not found",
      "description": "Requests that answered 404, bots included. The paths are on the internal dashboard only: any request picks them.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"site-traffic\"} | json | status=\"404\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 10
      },
      "id": 13
    }
  ],
  "links": [
