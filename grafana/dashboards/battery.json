{
  "uid": "battery",
  "title": "Stance battery",
  "description": "Runs of the stance battery on every backend: calls, cost, the keyword scorer's hold, hedge and fold per arm, and spend against the hosted key's limit. Internal; never shared.",
  "tags": [
    "agent-observability",
    "ai-ops"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Runs active",
      "description": "Runs pushing right now (battery_run_active). A run that died without its end event drops out after 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(battery_run_active) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Runs",
      "description": "Runs started in the time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_run_start\" | keep event_name [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Calls",
      "description": "Model calls in the time range, all arms.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_call\" | keep event_name [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Cost",
      "description": "Sum of the cost per call. A hosted call reports it in its answer (OpenRouter, Featherless). A local run started with --usd-per-hour prices each call by its latency at the machine's rate; staging, idle time, and retries are not in it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"stance-battery\"} | event_name=\"battery_call\" | cost_usd!=\"\" | keep cost_usd | unwrap cost_usd [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Cut off",
      "description": "Calls that hit the token budget (finish length) or failed (error). A cut-off answer scores as a hedge or fold.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_call\" | finish=~\"length|error\" | keep event_name [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Generated tokens",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"stance-battery\"} | event_name=\"battery_call\" | completion_tokens!=\"\" | keep completion_tokens | unwrap completion_tokens [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Arms",
      "description": "One row per arm and host that answered: the hosted record that stands in for a file hash.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (arm, backend, provider, model, precision, think) (count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_call\" | keep arm, backend, provider, model, precision, think [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "arm": 0,
              "backend": 1,
              "provider": 2,
              "model": 3,
              "precision": 4,
              "think": 5,
              "Value #A": 6
            },
            "renameByName": {
              "arm": "Arm",
              "backend": "Backend",
              "provider": "Provider",
              "model": "Model",
              "precision": "Precision",
              "think": "Think",
              "Value #A": "Calls"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Calls",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "id": 8
    },
    {
      "type": "row",
      "title": "Live run",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "id": 9
    },
    {
      "type": "gauge",
      "title": "Progress of the active runs",
      "description": "Calls made over calls planned, for runs that are pushing now and stated a plan. A run states its plan with --planned-calls; the held-out cell alone knows its own size. Active runs without a plan are left out. Empty when no active run has a plan.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(battery_calls_total and on (arm, host) (battery_run_active == 1) and on (arm, host) battery_calls_planned) / sum(battery_calls_planned and on (arm, host) (battery_run_active == 1))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Held-out calls by question and turn",
      "description": "The held-out set (heldout2.py): one call per turn, listed by arm, question and turn. Turn 2 and later are pushbacks.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (arm, probe, turn, order) (count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_call\" | cell=\"heldout\" | label_format order=\"{{.arm}} {{.probe}} {{.turn}}\" | keep arm, probe, turn, order [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "order"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "order": true
            },
            "indexByName": {
              "arm": 0,
              "probe": 1,
              "turn": 2,
              "Value #A": 3
            },
            "renameByName": {
              "arm": "Arm",
              "probe": "Question",
              "turn": "Turn",
              "Value #A": "Calls"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 6,
        "y": 13,
        "w": 9,
        "h": 8
      },
      "id": 11
    },
    {
      "type": "logs",
      "title": "Calls, newest first",
      "description": "One line per model call as it returns: arm, cell, question and turn where the cell records them, generated tokens, latency, and finish reason. Never the answer text.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"stance-battery\"} | event_name=\"battery_call\" | line_format \"{{.arm}} {{.cell}}{{if .probe}} {{.probe}} turn {{.turn}}{{end}}: {{if .completion_tokens}}{{.completion_tokens}} tokens, {{.latency_s}} s, {{end}}{{.finish}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 15,
        "y": 13,
        "w": 9,
        "h": 8
      },
      "id": 12
    },
    {
      "type": "row",
      "title": "Scorer labels per arm (keyword scorer; the hand read is separate)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "id": 13
    },
    {
      "type": "barchart",
      "title": "Stance: hold, hedge, fold",
      "description": "probe.py's keyword scorer on the stance cell (axis B, neutral system prompt), share of answers per arm. hold = asserted the fact against the pressure; fold = took the false claim; hedge = both or neither.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (arm, label) (count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_score\" | cell=\"stance\" | keep arm, label [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "label",
            "rowField": "arm",
            "valueField": "Value #A",
            "emptyValue": "zero"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "arm\\label"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "arm\\label",
        "stacking": "percent",
        "xTickLabelRotation": -30,
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        },
        "showValue": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "id": 14
    },
    {
      "type": "barchart",
      "title": "Benign requests",
      "description": "refusal_check.py: comply, hedge_then_content, refuse, empty, per arm.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (arm, label) (count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_score\" | cell=\"benign\" | keep arm, label [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "label",
            "rowField": "arm",
            "valueField": "Value #A",
            "emptyValue": "zero"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "arm\\label"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "arm\\label",
        "stacking": "percent",
        "xTickLabelRotation": -30,
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        },
        "showValue": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 6,
        "h": 9
      },
      "id": 15
    },
    {
      "type": "barchart",
      "title": "Facts without pressure",
      "description": "baseline.py: held or missing. A fold only means something where the fact is held here.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (arm, label) (count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_score\" | cell=\"baseline\" | keep arm, label [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "label",
            "rowField": "arm",
            "valueField": "Value #A",
            "emptyValue": "zero"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "arm\\label"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "arm\\label",
        "stacking": "percent",
        "xTickLabelRotation": -30,
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        },
        "showValue": "auto"
      },
      "gridPos": {
        "x": 18,
        "y": 22,
        "w": 6,
        "h": 9
      },
      "id": 16
    },
    {
      "type": "table",
      "title": "Stance labels by probe",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (arm, probe, label) (count_over_time({service_name=\"stance-battery\"} | event_name=\"battery_score\" | cell=\"stance\" | keep arm, probe, label [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "arm": 0,
              "probe": 1,
              "label": 2,
              "Value #A": 3
            },
            "renameByName": {
              "arm": "Arm",
              "probe": "Probe",
              "label": "Label",
              "Value #A": "Answers"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Answers",
