    {
      "type": "row",
      "title": "Cost and spend",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "id": 18
    },
    {
      "type": "table",
      "title": "Cost per arm",
      "description": "Hosted arms: the cost the host billed per call. Arms with provider local: machine time, each call's latency at the --usd-per-hour rate. That is an estimate of compute used; the bill comes from the provider.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (arm, provider) (sum_over_time({service_name=\"stance-battery\"} | event_name=\"battery_call\" | cost_usd!=\"\" | keep arm, provider, cost_usd | unwrap cost_usd [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "arm": 0,
              "provider": 1,
              "Value #A": 2
            },
            "renameByName": {
              "arm": "Arm",
              "provider": "Provider",
              "Value #A": "USD"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "USD",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "id": 19
    },
    {
      "type": "gauge",
      "title": "OpenRouter key: spend against limit",
      "description": "Usage over the key's credit limit, read from /api/v1/key at the start, every 20 calls and the end of each run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(last_over_time(battery_key_usage_usd{backend=\"openrouter\"}[30d])) / max(last_over_time(battery_key_limit_usd{backend=\"openrouter\"}[30d]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
