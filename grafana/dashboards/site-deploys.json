{
  "uid": "site-deploys",
  "title": "Website deploys",
  "description": "GitHub Actions deploys of machinebehavior.io, tychat.io and uncovertechtalent.com, the conformity gate in front of them, and what each deploy shipped.",
  "tags": [
    "agent-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Latest run deployed",
      "description": "1 when the latest run deployed. A run the gate blocked leaves the previous build live and shows here as not deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "site_deploy_last_deployed",
          "refId": "A",
          "legendFormat": "{{site}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "deployed",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "not deployed",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 9,
        "h": 5
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Since the latest deploy",
      "description": "Time since each site's latest deploy run finished.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - site_deploy_last_finished_timestamp_seconds",
          "refId": "A",
          "legendFormat": "{{site}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 86400,
                "color": "yellow"
              },
              {
                "value": 604800,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 9,
        "h": 5
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Open gate findings",
      "description": "Findings the conformity gate holds open across the three sites.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(site_conformity_findings_open)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Runs seen",
      "description": "Completed deploy runs the exporter has read from GitHub Actions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(site_deploy_runs_total)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "History",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Deploy runs by outcome",
      "description": "Every completed run of the deploy workflows, per hour. Blocked = the conformity gate failed and the deploy job never ran.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (outcome) (count_over_time({job=\"site-deploys\"}[$__interval]))",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "deployed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Run duration, push to live",
      "description": "Wall time of each deployed run, from the first job starting to the deploy job finishing.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (site) (max_over_time({job=\"site-deploys\", outcome=\"deployed\"} | json | unwrap duration_s [$__interval]))",
          "refId": "A",
          "legendFormat": "{{site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "bargauge",
      "title": "Where the time goes (machinebehavior.io)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Average duration of each workflow step over the selected range.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "avg by (step) (avg_over_time({job=\"site-deploy-steps\", site=\"machinebehavior.io\"} | json | unwrap duration_s [$__interval]))",
          "refId": "A",
          "legendFormat": "{{step}}",
          "queryType": "range"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "id": 9
    },
    {
      "type": "state-timeline",
      "title": "Gate checks (machinebehavior.io)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Result of each conformity check on every run. Partial and pending checks are recorded and do not block; a fail blocks the deploy.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "min by (check) (min_over_time({job=\"site-gate-checks\", site=\"machinebehavior.io\"} | json | unwrap state [$__interval]))",
          "refId": "A",
          "legendFormat": "{{check}}",
          "queryType": "range"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fail",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "pending",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "partial",
                  "color": "yellow",
                  "index": 2
                },
                "3": {
                  "text": "pass",
                  "color": "green",
                  "index": 3
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "What the deploy shipped",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "id": 11
    },
    {
      "type": "stat",
      "title": "Map nodes",
      "description": "Pages, posts, repos, threads and tags in the map snapshot the latest deploy shipped.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "site_map_nodes",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "text": {
          "valueSize": 44
        }
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 3,
        "h": 5
      },
      "id": 12
    },
    {
      "type": "stat",
      "title": "Map links",
      "description": "Links in that snapshot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "site_map_links",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "text": {
          "valueSize": 44
        }
      },
      "gridPos": {
        "x": 3,
        "y": 25,
        "w": 3,
        "h": 5
      },
      "id": 13
    },
    {
      "type": "stat",
      "title": "Links carried forward",
      "description": "Substack refuses the CI runner, so links of unreachable pages come from the previous snapshot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "site_map_carried_links",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "text": {
          "valueSize": 44
        }
      },
      "gridPos": {
        "x": 6,
        "y": 25,
        "w": 3,
        "h": 5
      },
      "id": 14
    },
    {
      "type": "stat",
      "title": "Pages dropped",
      "description": "Pages that answered with something other than HTML.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "site_map_dropped_pages",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "text": {
          "valueSize": 44
        }
      },
      "gridPos": {
        "x": 9,
        "y": 25,
        "w": 3,
        "h": 5
      },
      "id": 15
    },
    {
      "type": "stat",
      "title": "Decision probe: fold rate",
      "description": "Weekly probe from .161: share of WAIT runs where a reference model switched to BUY under scripted pushback. Record-only until 2026-11-04; it never blocks a deploy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "site_probe_fold_ratio",
          "refId": "A",
          "legendFormat": "{{arm}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 5
      },
      "id": 16
    },
    {
      "type": "row",
      "title": "Run log",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "id": 17
    },
    {
      "type": "logs",
      "title": "Deploy runs",
      "description": "One line per run. Titles show for the public repos only.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"site-deploys\"} | json | line_format \"{{.site}}  #{{.run_number}}  {{.outcome}}  {{.duration_s}}s  gate={{.gate}}  {{.title}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "id": 18
    }
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "agent-observability"
      ],
      "asDropdown": true,
      "title": "Dashboards"
    }
  ],
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "name": "Deploys",
        "iconColor": "rgba(255, 181, 71, 0.9)",
        "expr": "{job=\"site-deploys\"} | json | line_format \"{{.site}} #{{.run_number}} {{.outcome}} in {{.duration_s}}s\"",
        "tagKeys": "site,outcome",
        "titleFormat": "Deploy",
        "textFormat": "",
        "filter": {
          "exclude": false,
          "ids": [
            8
          ]
        }
      }
    ]
  }
}
