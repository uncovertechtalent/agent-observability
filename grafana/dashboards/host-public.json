        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max without (instance, job, uuid, name, device, mountpoint, fstype, chip, sensor) (sum(rate(node_disk_read_bytes_total{job=\"node\",device!~\"loop.*|ram.*|zd.*\"}[5m])))",
