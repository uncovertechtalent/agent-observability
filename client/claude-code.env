# Claude Code -> Alloy. Source this, or copy the keys into the "env" block of
# ~/.claude/settings.json. Replace OBS_HOST with the host running the stack.
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_TRACES_EXPORTER=otlp
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://${OBS_HOST:-localhost}:4317
# Prometheus stores cumulative series.
export OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
export OTEL_METRIC_EXPORT_INTERVAL=15000
# Session IDs belong in events and traces, not metric labels: one new series
# set per session grows cardinality without bound.
export OTEL_METRICS_INCLUDE_SESSION_ID=false
# Tool and skill names in events. Prompt and response text stay off.
export OTEL_LOG_TOOL_DETAILS=1
