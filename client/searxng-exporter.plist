<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for the SearXNG exporter on macOS. Replace the __PLACEHOLDERS__ and copy to
     ~/Library/LaunchAgents/searxng-exporter.plist; see the README. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>searxng-exporter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO__/client/searxng_exporter.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <!-- Alloy's OTLP/HTTP port on the host that runs the stack -->
        <key>OTLP_ENDPOINT</key>
        <string>http://__OBS_HOST__:4318</string>
        <!-- Optional: the HTTP proxy some engines use, and the exit IP it should show -->
        <key>SEARXNG_PROXY</key>
        <string>__PROXY_URL__</string>
        <key>SEARXNG_PROXY_EXIT_IP</key>
        <string>__PROXY_EXIT_IP__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.cache/searxng-exporter.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.cache/searxng-exporter.err</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
