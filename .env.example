GRAFANA_ADMIN_PASSWORD=change-me
# OLLAMA_UPSTREAM=http://host.docker.internal:11434
# PROM_RETENTION=90d
# Transparent mode: Ollama on 11436, proxy on Ollama's usual port.
# OLLAMA_PROXY_PORT=11434
# OLLAMA_UPSTREAM=http://host.docker.internal:11436
# Website deploy history: a token with read access to the site repos' Actions.
GITHUB_TOKEN=
# A fine-grained token covers one owner (user or organisation). Repos of another owner read
# GITHUB_TOKEN_<OWNER> (owner upper-cased, other characters as "_"). The exporter needs Actions (read)
# and Metadata (read) on its repos, nothing more; an organisation that requires approval of
# fine-grained tokens must approve it first, or the private repo answers 404. Each new owner also needs
# a line in docker-compose.yml, or the container never sees the variable.
# GITHUB_TOKEN_OWNER=uncovertechtalent   # the owner GITHUB_TOKEN covers (default)
GITHUB_TOKEN_UNCOVERTECHTALENT_GIT=
